# Server configuration only. Never prefix these keys with VITE_.
# The local test adapter works without these values and is never bundled in the Worker.
PILOT_ENABLED=false
PILOT_ORIGIN=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated exact HTTPS origins needed by the registered provider, in addition to its issuer origin.
OIDC_ALLOWED_ORIGINS=
# Public indexing remains off until the offer, contacts and deployment are approved.
VITE_PUBLIC_INDEXING_ENABLED=false
VITE_PUBLIC_SITE_URL=
